<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Avoid restoring local authentication/session credentials as part of an app-data backup. -->
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Require authentication on the destination device instead of copying auth preferences. -->
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
