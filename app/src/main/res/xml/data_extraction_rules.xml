<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep local financial rows and local session credentials out of cloud app-data backup.
             Users can export an authenticated, password-encrypted backup explicitly. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Do not silently transfer locally stored financial records or auth preferences to a
             different device. Use the application's password-protected restore flow instead. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
